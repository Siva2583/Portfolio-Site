# Supabase project settings (server-side only; never put these in browser code)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Resend (server-side only). Use a sender address verified by Resend.
RESEND_API_KEY=re_********************************
CONTACT_TO_EMAIL=your-inbox@example.com
CONTACT_FROM_EMAIL=Siva Charan <portfolio@your-verified-domain.example>

# Generate a random 32+ character secret for HMAC-based rate-limit fingerprints.
CONTACT_RATE_LIMIT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Exact public origin in production; e.g. https://your-domain.example
# In local development, same-origin requests are checked against the request host.
ALLOWED_ORIGIN=https://your-domain.example
